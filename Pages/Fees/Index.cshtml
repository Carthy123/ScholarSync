@page
@model ScholarSync.Pages.Fees.IndexModel
@{
    ViewData["Title"] = "Fee Payments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1>Fee Payments</h1><p class="text-muted mb-0">Record payments and monitor outstanding balances.</p></div>
    @if (User.IsInRole("Admin")){<a asp-page="/Fees/Structures" class="btn btn-outline-primary">Manage fee structures</a>}
    <div class="badge text-bg-success fs-6">Total shown: GHS @Model.TotalReceived.ToString("N2")</div>
</div>

<div class="card shadow-sm mb-4"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="h5 mb-1">Student balances</h2><p class="text-muted mb-0">Expected, paid, and outstanding for one term.</p></div><div><strong>Outstanding: GHS @Model.TotalOutstanding.ToString("N2")</strong></div></div>
    <form method="get" class="row g-2 align-items-end mb-3"><div class="col-md-3"><label asp-for="BalanceAcademicYear" class="form-label">Academic year</label><input asp-for="BalanceAcademicYear" class="form-control" /></div><div class="col-md-3"><label asp-for="BalanceTerm" class="form-label">Term</label><select asp-for="BalanceTerm" class="form-select">@foreach (var term in Model.Terms){<option value="@term">@term</option>}</select></div><div class="col-auto"><button class="btn btn-outline-primary" type="submit">View balances</button></div></form>
    <div class="table-responsive"><table class="table table-sm table-bordered mb-0"><thead class="table-light"><tr><th>Student</th><th>Class</th><th>Expected</th><th>Paid</th><th>Outstanding</th></tr></thead><tbody>
    @if (Model.Balances.Count == 0){<tr><td colspan="5" class="text-center text-muted py-3">No students or fee structures found for this selection.</td></tr>}
    @foreach (var balance in Model.Balances){<tr><td>@balance.Student.FirstName @balance.Student.LastName</td><td>@(balance.Student.SchoolClass?.Name ?? "Unassigned")</td><td>GHS @balance.Expected.ToString("N2")</td><td>GHS @balance.Paid.ToString("N2")</td><td class="@(balance.Outstanding > 0 ? "text-danger" : "text-success")"><strong>GHS @balance.Outstanding.ToString("N2")</strong></td></tr>}
    </tbody></table></div>
</div></div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5">Record payment</h2>
        <form method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-md-4"><label asp-for="Input.StudentId" class="form-label">Student</label><select asp-for="Input.StudentId" class="form-select"><option value="">Select student</option>@foreach (var student in Model.Students){<option value="@student.Id">@student.FirstName @student.LastName</option>}</select><span asp-validation-for="Input.StudentId" class="text-danger"></span></div>
            <div class="col-md-2"><label asp-for="Input.Term" class="form-label">Term</label><select asp-for="Input.Term" class="form-select">@foreach (var term in Model.Terms){<option value="@term">@term</option>}</select></div>
            <div class="col-md-2"><label asp-for="Input.AcademicYear" class="form-label">Academic year</label><input asp-for="Input.AcademicYear" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="Input.Amount" class="form-label">Amount (GHS)</label><input asp-for="Input.Amount" class="form-control" type="number" step="0.01" /></div>
            <div class="col-md-2"><label asp-for="Input.PaymentDate" class="form-label">Payment date</label><input asp-for="Input.PaymentDate" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="Input.ReceiptNumber" class="form-label">Receipt number</label><input asp-for="Input.ReceiptNumber" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Input.Notes" class="form-label">Notes</label><input asp-for="Input.Notes" class="form-control" /></div>
            <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-primary w-100">Save payment</button></div>
        </form>
    </div>
</div>

<div class="table-responsive"><table class="table table-bordered align-middle"><thead class="table-light"><tr><th>Date</th><th>Student</th><th>Term</th><th>Year</th><th>Amount</th><th>Receipt</th><th>Notes</th><th></th></tr></thead><tbody>
@if (Model.Payments.Count == 0){<tr><td colspan="8" class="text-center text-muted py-4">No payments recorded yet.</td></tr>}
@foreach (var payment in Model.Payments){<tr><td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td><td>@payment.Student.FirstName @payment.Student.LastName</td><td>@payment.Term</td><td>@payment.AcademicYear</td><td>GHS @payment.Amount.ToString("N2")</td><td>@(payment.ReceiptNumber ?? "—")</td><td>@(payment.Notes ?? "—")</td><td><a asp-page="/Fees/Receipt" asp-route-id="@payment.Id" class="btn btn-sm btn-outline-primary">Receipt</a></td></tr>}
</tbody></table></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
