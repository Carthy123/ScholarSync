@page
@model ScholarSync.Pages.Announcements.IndexModel
@{ ViewData["Title"] = "School Operations Bulletin"; }

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><span class="text-uppercase text-primary small fw-bold">School communication</span><h1 class="mb-1">School Operations Bulletin</h1><p class="text-muted mb-0">Important information for the people responsible for the school day.</p></div>@if (User.IsInRole("Admin")){<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#announcementModal">+ Publish notice</button>}</div>

<div class="announcement-list">
@if (Model.Announcements.Count == 0){<div class="card shadow-sm"><div class="card-body text-center py-5"><div class="announcement-empty-icon">✦</div><h2 class="h5">No active notices</h2><p class="text-muted mb-0">Published school notices will appear here.</p></div></div>}
@foreach (var announcement in Model.Announcements)
{
    <article class="announcement-card @announcement.Priority.ToLowerInvariant() @(announcement.IsPinned ? "pinned" : "")"><div class="announcement-card-top"><span class="announcement-category">@announcement.Category</span><span class="announcement-priority">@announcement.Priority@(announcement.IsPinned ? " · Pinned" : "")</span></div><h2>@announcement.Title</h2><p>@announcement.Message</p><div class="announcement-meta"><span>For @announcement.Audience</span><span>Published @announcement.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</span>@if (announcement.ExpiresAt.HasValue){<span>Expires @announcement.ExpiresAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span>}</div><div class="announcement-actions">@if (Model.AcknowledgedIds.Contains(announcement.Id)){<span class="acknowledged">✓ Acknowledged</span>}else{<form method="post" asp-page-handler="Acknowledge" asp-route-id="@announcement.Id"><button class="btn btn-sm btn-outline-primary" type="submit">Acknowledge notice</button></form>}@if (User.IsInRole("Admin")){<form method="post" asp-page-handler="Delete" asp-route-id="@announcement.Id"><button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Remove this notice?');">Remove</button></form>}</div></article>
}
</div>

@if (User.IsInRole("Admin"))
{
<div class="modal fade" id="announcementModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-page-handler="Create"><div class="modal-header"><h5 class="modal-title">Publish school notice</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-12"><label asp-for="Input.Title" class="form-label">Title</label><input asp-for="Input.Title" class="form-control" placeholder="e.g. Midterm examination reminder" /></div><div class="col-md-4"><label asp-for="Input.Category" class="form-label">Category</label><select asp-for="Input.Category" class="form-select">@foreach (var item in Model.AvailableCategories){<option value="@item">@item</option>}</select></div><div class="col-md-4"><label asp-for="Input.Priority" class="form-label">Priority</label><select asp-for="Input.Priority" class="form-select">@foreach (var item in Model.AvailablePriorities){<option value="@item">@item</option>}</select></div><div class="col-md-4"><label asp-for="Input.Audience" class="form-label">Audience</label><select asp-for="Input.Audience" class="form-select">@foreach (var item in Model.AvailableAudiences){<option value="@item">@item</option>}</select></div><div class="col-12"><label asp-for="Input.Message" class="form-label">Message</label><textarea asp-for="Input.Message" rows="4" class="form-control" placeholder="Write the information staff need to know"></textarea></div><div class="col-md-7"><label asp-for="Input.ExpiresAt" class="form-label">Expiry date and time</label><input asp-for="Input.ExpiresAt" class="form-control" /></div><div class="col-md-5 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="Input.IsPinned" class="form-check-input" /><label asp-for="Input.IsPinned" class="form-check-label">Pin to the top</label></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Publish notice</button></div></form></div></div></div>
}
