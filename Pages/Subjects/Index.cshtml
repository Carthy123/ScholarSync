@page
@model ScholarSync.Pages.Subjects.IndexModel

@{
    ViewData["Title"] = "Subject Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-1">Subject Management</h1>
        <p class="text-muted mb-0">Keep the subject list current without changing the code.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Subjects/Assignments" class="btn btn-primary">Assign to classes</a>
        <a asp-page="/Grades/Index" class="btn btn-outline-secondary">Back to academic records</a>
    </div>
</div>

@if (TempData["SubjectMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Add a subject</h2>
                <p class="small text-muted">Choose the school stages where this subject is offered.</p>
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label">Subject name</label>
                        <input asp-for="Input.Name" class="form-control" placeholder="For example, French" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Level" class="form-label">Available for</label>
                        <select asp-for="Input.Level" class="form-select">
                            @foreach (var level in Model.LevelOptions)
                            {
                                <option value="@level">@level</option>
                            }
                        </select>
                        <span asp-validation-for="Input.Level" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Add subject</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Subjects</h2>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Subject</th><th>School stage</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var subject in Model.Subjects)
                        {
                            <tr>
                                <td>@subject.Name</td>
                                <td>@subject.Level</td>
                                <td><span class="badge @(subject.IsActive ? "text-bg-success" : "text-bg-secondary")">@(subject.IsActive ? "Active" : "Archived")</span></td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Toggle">
                                        <input type="hidden" name="id" value="@subject.Id" />
                                        <button type="submit" class="btn btn-sm @(subject.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(subject.IsActive ? "Archive" : "Activate")</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (Model.Subjects.Count == 0)
                        {
                            <tr><td colspan="4" class="text-muted">No subjects have been added yet.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
