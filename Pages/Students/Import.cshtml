@page
@model ScholarSync.Pages.Students.ImportModel

@{
    ViewData["Title"] = "Import students";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1>Import students</h1>
        <p class="text-muted mb-0">Upload a CSV file to register several learners safely in one step.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page-handler="TemplateCsv" class="btn btn-outline-success">Download Excel/CSV template</a>
        <a asp-page="/Students/Index" class="btn btn-outline-secondary">Back to students</a>
    </div>
</div>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="alert alert-info">
    <strong>How it works:</strong> the file is checked first. Nothing is saved until every row is valid. The template can be opened and edited in Microsoft Excel, then saved as CSV.
</div>

<form method="post" enctype="multipart/form-data" asp-page-handler="Preview" class="card card-body shadow-sm mb-4">
    <label asp-for="ImportFile" class="form-label fw-semibold">Student CSV file</label>
    <input asp-for="ImportFile" type="file" accept=".csv,text/csv" class="form-control" />
    <div class="form-text">Maximum size: 10 MB. Required columns: First Name and Last Name.</div>
    <button type="submit" class="btn btn-primary mt-3">Validate and preview</button>
</form>

@if (Model.HasPreview)
{
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2 align-items-center">
                <div>
                    <h2 class="h4 mb-1">Preview</h2>
                    <p class="text-muted mb-0">@Model.PreviewMessage</p>
                </div>
                @if (Model.PreviewIsValid)
                {
                    <form method="post" asp-page-handler="Commit">
                        <input type="hidden" asp-for="ImportToken" />
                        <button type="submit" class="btn btn-success" onclick="return confirm('Import these student records now?');">Import valid records</button>
                    </form>
                }
            </div>
            <div class="table-responsive mt-3">
                <table class="table table-sm table-bordered align-middle">
                    <thead><tr><th>Line</th><th>Student</th><th>Date of birth</th><th>Class</th><th>Guardian</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.PreviewRows)
                    {
                        <tr class="@(row.IsValid ? "" : "table-danger")">
                            <td>@row.LineNumber</td>
                            <td>@row.FirstName @row.LastName</td>
                            <td>@row.DateOfBirthText</td>
                            <td>@(string.IsNullOrWhiteSpace(row.ClassName) ? "Unassigned" : $"{row.ClassName} ({row.AcademicYear})")</td>
                            <td>@row.GuardianName</td>
                            <td>
                                @if (row.IsValid) { <span class="badge text-bg-success">Ready</span> }
                                else { <span class="text-danger">@string.Join(" ", row.Errors)</span> }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
