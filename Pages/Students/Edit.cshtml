@page
@model ScholarSync.Pages.Students.EditModel

@{
    ViewData["Title"] = "Edit Student";
}

<h1>Edit Student</h1>

<form method="post">
    <input type="hidden" asp-for="Student.Id" />

    <div class="mb-3">
        <label asp-for="Student.FirstName" class="form-label"></label>
        <input asp-for="Student.FirstName" class="form-control" />
        <span asp-validation-for="Student.FirstName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Student.LastName" class="form-label"></label>
        <input asp-for="Student.LastName" class="form-control" />
        <span asp-validation-for="Student.LastName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Student.DateOfBirth" class="form-label"></label>
        <input asp-for="Student.DateOfBirth" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Student.Gender" class="form-label"></label>
        <input asp-for="Student.Gender" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Student.SchoolClassId" class="form-label">Class</label>
        <select asp-for="Student.SchoolClassId" class="form-select">
            <option value="">-- Unassigned --</option>
            @foreach (var schoolClass in Model.Classes)
            {
                <option value="@schoolClass.Id">@schoolClass.Name (@schoolClass.AcademicYear)</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Student.GuardianName" class="form-label"></label>
        <input asp-for="Student.GuardianName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Student.GuardianPhone" class="form-label"></label>
        <input asp-for="Student.GuardianPhone" class="form-control" />
    </div>
    <div class="mb-3"><label asp-for="Student.GuardianEmail" class="form-label">Guardian email</label><input asp-for="Student.GuardianEmail" type="email" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Student.GuardianAddress" class="form-label">Guardian address</label><textarea asp-for="Student.GuardianAddress" class="form-control" rows="2"></textarea></div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="Student.EmergencyContactName" class="form-label">Emergency contact name</label><input asp-for="Student.EmergencyContactName" class="form-control" /></div>
        <div class="col-md-6 mb-3"><label asp-for="Student.EmergencyContactPhone" class="form-label">Emergency contact phone</label><input asp-for="Student.EmergencyContactPhone" class="form-control" /></div>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-page="/Students/Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
