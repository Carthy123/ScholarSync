@page
@model ScholarSync.Pages.Students.CreateModel

@{
    ViewData["Title"] = "Register Student";
}

<h1>Register Student</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="Student.FirstName" class="form-label"></label>
        <input asp-for="Student.FirstName" class="form-control" />
        <span asp-validation-for="Student.FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Student.LastName" class="form-label"></label>
        <input asp-for="Student.LastName" class="form-control" />
        <span asp-validation-for="Student.LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Student.DateOfBirth" class="form-label"></label>
        <input asp-for="Student.DateOfBirth" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Student.Gender" class="form-label"></label>
        <input asp-for="Student.Gender" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Student.SchoolClassId" class="form-label">
            Class
        </label>

        <select asp-for="Student.SchoolClassId" class="form-select">
            <option value="">-- Select class --</option>

            @foreach (var schoolClass in Model.Classes)
            {
                <option value="@schoolClass.Id">
                    @schoolClass.Name (@schoolClass.AcademicYear)
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Student.GuardianName" class="form-label"></label>
        <input asp-for="Student.GuardianName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Student.GuardianPhone" class="form-label"></label>
        <input asp-for="Student.GuardianPhone" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save Student
    </button>

    <a asp-page="/Students/Index" class="btn btn-secondary">
        Cancel
    </a>
</form>