@page
@model ScholarSync.Pages.Students.CreateModel

@{
    ViewData["Title"] = "Register Student";
}

<h1>Register Student</h1>

<form method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label asp-for="Student.FirstName" class="form-label"></label>
        <input asp-for="Student.FirstName" class="form-control" />
        <span asp-validation-for="Student.FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Student.LastName" class="form-label"></label>
        <input asp-for="Student.LastName" class="form-control" />
        <span asp-validation-for="Student.LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Student.DateOfBirth" class="form-label"></label>
        <input asp-for="Student.DateOfBirth" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Student.Gender" class="form-label"></label>
        <input asp-for="Student.Gender" class="form-control" />
    </div>

    <div class="mb-3"><label asp-for="PhotoFile" class="form-label">Student photo (optional)</label><input asp-for="PhotoFile" type="file" accept=".png,.jpg,.jpeg,.webp" class="form-control" /><div class="form-text">PNG, JPG, JPEG, or WEBP up to 2 MB.</div><span asp-validation-for="PhotoFile" class="text-danger"></span></div>

    <div class="mb-3">
        <label asp-for="Student.SchoolClassId" class="form-label">
            Class
        </label>

        <select asp-for="Student.SchoolClassId" class="form-select">
            <option value="">-- Select class --</option>

            @foreach (var schoolClass in Model.Classes)
            {
                <option value="@schoolClass.Id">
                    @schoolClass.Name (@schoolClass.AcademicYear)
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Student.GuardianName" class="form-label"></label>
        <input asp-for="Student.GuardianName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Student.GuardianPhone" class="form-label"></label>
        <input asp-for="Student.GuardianPhone" class="form-control" />
    </div>
    <div class="mb-3"><label asp-for="Student.GuardianEmail" class="form-label">Guardian email</label><input asp-for="Student.GuardianEmail" type="email" class="form-control" /></div>
    <div class="row"><div class="col-md-4 mb-3"><label asp-for="Student.GuardianPreferredChannel" class="form-label">Preferred communication channel</label><select asp-for="Student.GuardianPreferredChannel" class="form-select"><option>Any</option><option>Email</option><option>SMS</option><option>WhatsApp</option><option>In-app</option></select></div><div class="col-md-4 mb-3 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="Student.GuardianContactVerified" class="form-check-input" /><label asp-for="Student.GuardianContactVerified" class="form-check-label">Contact details verified</label></div></div><div class="col-md-4 mb-3 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="Student.GuardianCommunicationOptOut" class="form-check-input" /><label asp-for="Student.GuardianCommunicationOptOut" class="form-check-label">Guardian opted out</label></div></div></div>
    <div class="mb-3"><label asp-for="Student.GuardianAddress" class="form-label">Guardian address</label><textarea asp-for="Student.GuardianAddress" class="form-control" rows="2"></textarea></div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="Student.EmergencyContactName" class="form-label">Emergency contact name</label><input asp-for="Student.EmergencyContactName" class="form-control" /></div>
        <div class="col-md-6 mb-3"><label asp-for="Student.EmergencyContactPhone" class="form-label">Emergency contact phone</label><input asp-for="Student.EmergencyContactPhone" class="form-control" /></div>
    </div>

    @if (Model.ShowHealthWelfare)
    {
        <div class="student-health-section mt-4 mb-4"><h2 class="h5">Health &amp; welfare <span class="badge text-bg-light">Protected</span></h2><p class="text-muted small">Only authorized staff should enter information needed to support the student safely at school.</p><div class="row"><div class="col-md-6 mb-3"><label asp-for="Student.MedicalConditions" class="form-label">Medical conditions</label><textarea asp-for="Student.MedicalConditions" class="form-control" rows="2"></textarea></div><div class="col-md-6 mb-3"><label asp-for="Student.Allergies" class="form-label">Allergies</label><textarea asp-for="Student.Allergies" class="form-control" rows="2"></textarea></div><div class="col-md-4 mb-3"><label asp-for="Student.BloodGroup" class="form-label">Blood group</label><select asp-for="Student.BloodGroup" class="form-select"><option value="">Not provided</option><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></div><div class="col-md-8 mb-3"><label asp-for="Student.MedicationNotes" class="form-label">Medication or care instructions</label><textarea asp-for="Student.MedicationNotes" class="form-control" rows="2"></textarea></div><div class="col-md-7 mb-3"><label asp-for="Student.DoctorName" class="form-label">Doctor or clinic</label><input asp-for="Student.DoctorName" class="form-control" /></div><div class="col-md-5 mb-3"><label asp-for="Student.DoctorPhone" class="form-label">Doctor or clinic phone</label><input asp-for="Student.DoctorPhone" class="form-control" /></div><div class="col-12 mb-2"><label asp-for="Student.WelfareNotes" class="form-label">Welfare notes</label><textarea asp-for="Student.WelfareNotes" class="form-control" rows="3"></textarea></div></div></div>
    }

    <button type="submit" class="btn btn-primary">
        Save Student
    </button>

    <a asp-page="/Students/Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
