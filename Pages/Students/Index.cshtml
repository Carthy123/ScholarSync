@page
@model ScholarSync.Pages.Students.IndexModel

@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <form method="get" class="row g-2 align-items-end w-100" role="search">
        <div class="col-md-4">
            <label asp-for="SearchTerm" class="form-label mb-1">Search</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Student or guardian" aria-label="Search students or guardians" />
        </div>
        <div class="col-md-3">
            <label asp-for="ClassId" class="form-label mb-1">Class</label>
            <select asp-for="ClassId" class="form-select">
                <option value="">All classes</option>
                @foreach (var schoolClass in Model.Classes)
                {
                    <option value="@schoolClass.Id">@schoolClass.Name (@schoolClass.AcademicYear)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="AcademicYear" class="form-label mb-1">Academic year</label>
            <select asp-for="AcademicYear" class="form-select">
                <option value="">All years</option>
                @foreach (var year in Model.Classes.Select(schoolClass => schoolClass.AcademicYear).Distinct().OrderByDescending(year => year))
                {
                    <option value="@year">@year</option>
                }
            </select>
        </div>
        <input type="hidden" name="PageNumber" value="1" />
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Filter</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.ClassId.HasValue || !string.IsNullOrWhiteSpace(Model.AcademicYear))
            {
                <a asp-page="/Students/Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </form>

    <div class="d-flex gap-2">
    <a asp-page="/Students/Create" class="btn btn-primary">
        Register Student
    </a>
    <a asp-page-handler="ExportCsv" class="btn btn-outline-success">
        Export CSV
    </a>
</div>

<p class="text-muted">Showing @Model.Students.Count of @Model.TotalStudents student(s).</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Date of Birth</th>
            <th>Gender</th>
            <th>Guardian</th>
            <th>Phone</th>
            <th>Class</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Students.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-center text-muted py-4">
                    No students matched your search.
                </td>
            </tr>
        }

        @foreach (var student in Model.Students)
        {
            <tr>
                <td>@student.FirstName</td>
                <td>@student.LastName</td>
                <td>@student.DateOfBirth?.ToString("yyyy-MM-dd")</td>
                <td>@student.Gender</td>
                <td>@student.GuardianName</td>
                <td>@student.GuardianPhone</td>
                <td>@(student.SchoolClass == null ? "Unassigned" : $"{student.SchoolClass.Name} ({student.SchoolClass.AcademicYear})")</td>

                <td>
                    <a asp-page="/Students/Details"
                           asp-route-id="@student.Id"
                           class="btn btn-sm btn-info">
                        View
                    </a>
                    <a asp-page="/Students/Edit"
                           asp-route-id="@student.Id"
                           class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <form method="post"
                          asp-page-handler="Delete"
                          asp-route-id="@student.Id"
                          style="display:inline;">
                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('Delete this student?');">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalStudents > 0)
{
    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted">Page @Model.PageNumber of @Model.TotalPages</span>
        <div class="btn-group">
            @if (Model.PageNumber > 1)
            {
                <a class="btn btn-outline-secondary" asp-page="/Students/Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-ClassId="@Model.ClassId" asp-route-AcademicYear="@Model.AcademicYear" asp-route-PageNumber="@(Model.PageNumber - 1)">Previous</a>
            }
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a class="btn btn-outline-secondary" asp-page="/Students/Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-ClassId="@Model.ClassId" asp-route-AcademicYear="@Model.AcademicYear" asp-route-PageNumber="@(Model.PageNumber + 1)">Next</a>
            }
        </div>
    </div>
}
