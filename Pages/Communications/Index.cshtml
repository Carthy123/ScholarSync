@page
@model ScholarSync.Pages.Communications.IndexModel

@{ ViewData["Title"] = "Guardian communications"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h1>Guardian communications</h1><p class="text-muted mb-0">Send or record messages connected to a student and guardian.</p></div>
    <div class="d-flex gap-2"><a asp-page="/Communications/Bulk" class="btn btn-primary">Message a class</a>@if(User.IsInRole("Admin")){<a asp-page="/Communications/Templates" class="btn btn-outline-primary">Manage templates</a>}<a asp-page="/Guardians/Index" class="btn btn-outline-secondary">Guardian directory</a></div>
</div>

@if (TempData["CommunicationSaved"] is string message)
{
    <div class="alert alert-success">@message</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="alert alert-info"><strong>Delivery note:</strong> In-app messages are recorded immediately. Email requires Gmail SMTP settings. SMS and WhatsApp use Twilio when it is configured; messages remain pending until then.</div>

<div class="card shadow-sm mb-4"><div class="card-body">
    <h2 class="h5">New communication</h2>
    <form method="post" asp-page-handler="Send" class="row g-3">
        <div class="col-md-5"><label asp-for="Input.StudentId" class="form-label">Student / guardian</label><select asp-for="Input.StudentId" class="form-select"><option value="">Select student</option>@foreach (var student in Model.Students){<option value="@student.Id">@student.FirstName @student.LastName — @(student.GuardianName ?? "Guardian not provided")</option>}</select><span asp-validation-for="Input.StudentId" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="Input.Channel" class="form-label">Channel</label><select asp-for="Input.Channel" class="form-select">@foreach (var channel in Model.AvailableChannels){<option value="@channel">@channel</option>}</select><span asp-validation-for="Input.Channel" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Input.TemplateId" class="form-label">Use template (optional)</label><select asp-for="Input.TemplateId" class="form-select"><option value="">Write a new message</option>@foreach(var template in Model.Templates){<option value="@template.Id">@template.Name (@template.Channel)</option>}</select></div>
        <div class="col-md-4"><label asp-for="Input.Subject" class="form-label">Subject</label><input asp-for="Input.Subject" class="form-control" /><span asp-validation-for="Input.Subject" class="text-danger"></span></div>
        <div class="col-12"><label asp-for="Input.Message" class="form-label">Message</label><textarea asp-for="Input.Message" rows="4" class="form-control"></textarea><span asp-validation-for="Input.Message" class="text-danger"></span></div>
        <div class="col-12"><button type="submit" class="btn btn-primary">Save communication</button></div>
    </form>
</div></div>

<div class="card shadow-sm"><div class="card-body"><h2 class="h5">Communication history</h2><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Date</th><th>Student</th><th>Guardian</th><th>Channel</th><th>Subject</th><th>Status</th></tr></thead><tbody>
@if (Model.Communications.Count == 0){<tr><td colspan="6" class="text-center text-muted py-4">No communications recorded yet.</td></tr>}
@foreach (var item in Model.Communications){<tr><td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@item.Student.FirstName @item.Student.LastName</td><td>@item.RecipientName</td><td>@item.Channel</td><td>@item.Subject</td><td><span class="badge @(item.Status == "Sent" || item.Status == "Recorded" ? "text-bg-success" : item.Status == "Failed" ? "text-bg-danger" : "text-bg-warning")">@item.Status</span><small class="d-block text-muted">@item.StatusDetails</small>@if (!string.IsNullOrWhiteSpace(item.ProviderMessageId)){<small class="d-block text-muted">Provider ID: @item.ProviderMessageId</small>}</td></tr>}
</tbody></table></div></div></div>
