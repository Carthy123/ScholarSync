@page
@model ScholarSync.Pages.Communications.TemplatesModel

@{ ViewData["Title"] = "Communication templates"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h1>Communication templates</h1><p class="text-muted mb-0">Create ready-to-use messages for common school situations.</p></div><a asp-page="/Communications/Index" class="btn btn-outline-secondary">Back to communications</a></div>
@if (TempData["TemplateSaved"] is string saved){<div class="alert alert-success">@saved</div>}
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="card shadow-sm mb-4"><div class="card-body"><h2 class="h5">New template</h2><form method="post" asp-page-handler="Save" class="row g-3"><div class="col-md-4"><label asp-for="Input.Name" class="form-label">Template name</label><input asp-for="Input.Name" class="form-control" placeholder="Fee reminder" /><span asp-validation-for="Input.Name" class="text-danger"></span></div><div class="col-md-3"><label asp-for="Input.Category" class="form-label">Category</label><input asp-for="Input.Category" class="form-control" placeholder="Fees, Attendance, Exams" /><span asp-validation-for="Input.Category" class="text-danger"></span></div><div class="col-md-3"><label asp-for="Input.Channel" class="form-label">Channel</label><select asp-for="Input.Channel" class="form-select">@foreach(var channel in Model.AvailableChannels){<option value="@channel">@channel</option>}</select></div><div class="col-md-6"><label asp-for="Input.Subject" class="form-label">Subject</label><input asp-for="Input.Subject" class="form-control" /><span asp-validation-for="Input.Subject" class="text-danger"></span></div><div class="col-12"><label asp-for="Input.Message" class="form-label">Message</label><textarea asp-for="Input.Message" rows="4" class="form-control"></textarea><span asp-validation-for="Input.Message" class="text-danger"></span></div><div class="col-12"><button type="submit" class="btn btn-primary">Save template</button></div></form></div></div>
<div class="card shadow-sm"><div class="card-body"><h2 class="h5">Saved templates</h2><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Name</th><th>Category</th><th>Channel</th><th>Subject</th><th>Action</th></tr></thead><tbody>@if(Model.Templates.Count==0){<tr><td colspan="5" class="text-center text-muted py-4">No templates created yet.</td></tr>}@foreach(var template in Model.Templates){<tr><td><strong>@template.Name</strong><small class="d-block text-muted">@template.Message</small></td><td>@template.Category</td><td>@template.Channel</td><td>@template.Subject</td><td><form method="post" asp-page-handler="Delete" asp-route-id="@template.Id"><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this template?');">Delete</button></form></td></tr>}</tbody></table></div></div></div>
