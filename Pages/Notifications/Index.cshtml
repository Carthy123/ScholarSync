@page
@model ScholarSync.Pages.Notifications.IndexModel
@{ ViewData["Title"] = "Notifications"; }

<div class="d-flex justify-content-between align-items-start mb-4">
    <div><span class="text-uppercase text-primary small fw-bold">School operations</span><h1 class="mb-1">Notifications</h1><p class="text-muted mb-0">Important reminders and items that may need attention.</p></div>
    <span class="badge text-bg-primary fs-6">@Model.OpenCount open</span>
</div>
<div class="notification-list">
    @if (Model.Notifications.Count == 0)
    {
        <div class="card shadow-sm"><div class="card-body notification-empty"><div class="notification-empty-icon">✓</div><h2 class="h5">Everything is up to date</h2><p class="text-muted mb-0">There are no outstanding reminders for the records you can access.</p></div></div>
    }
    else
    {
        @foreach (var notification in Model.Notifications)
        {
            <a href="@notification.Link" class="notification-card @notification.Style text-decoration-none"><span class="notification-icon">@(notification.Style == "calendar" ? "▣" : notification.Style == "money" ? "₵" : notification.Style == "danger" ? "!" : notification.Style == "warning" ? "!" : "✓")</span><span class="notification-copy"><strong>@notification.Title</strong><small>@notification.Message</small></span><span class="notification-label">@notification.Label</span><span class="notification-arrow">→</span></a>
        }
    }
</div>
