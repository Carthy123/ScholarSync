@page
@model ScholarSync.Pages.Grades.IndexModel

@{
    ViewData["Title"] = "Grades";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h1 class="mb-1">Academic records</h1><p class="text-muted mb-0">Record results and open the school’s academic reports.</p></div>
    <div class="d-flex flex-wrap gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-page="/Subjects/Index" class="btn btn-outline-secondary">Manage subjects</a>
        }
        @if (Model.CanAccessReports)
        {
            <a asp-page="/Reports/Index" class="btn btn-outline-primary">Student report cards</a>
            <a asp-page="/Reports/Attendance" class="btn btn-outline-secondary">Attendance reports</a>
        }
        <a asp-page-handler="ExportCsv" class="btn btn-outline-success">Export grades</a>
    </div>
</div>

@if (Model.Students.Count == 0)
{
    <div class="alert alert-info">Register students before recording grades.</div>
}
else
{
    <form method="post" class="row g-3 mb-4">
        <div class="col-md-4">
            <label asp-for="Input.StudentId" class="form-label">Student</label>
            <select asp-for="Input.StudentId" class="form-select">
                <option value="0">-- Select student --</option>
                @foreach (var student in Model.Students)
                {
                    <option value="@student.Id" data-class-id="@student.SchoolClassId">@student.FirstName @student.LastName</option>
                }
            </select>
            <span asp-validation-for="Input.StudentId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.Subject" class="form-label"></label>
            <select asp-for="Input.Subject" class="form-select">
                <option value="">-- Select subject --</option>
                @foreach (var subject in Model.Subjects)
                {
                    <option value="@subject.Name" data-class-ids="@Model.AssignedClassIds(subject.Id)">@subject.Name (@subject.Level)</option>
                }
            </select>
            @if (Model.Subjects.Count == 0)
            {
                <div class="form-text">An administrator needs to add subjects before grades can be recorded.</div>
            }
            <span asp-validation-for="Input.Subject" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Input.Score" class="form-label"></label>
            <input asp-for="Input.Score" class="form-control" min="0" max="100" step="0.01" />
            <span asp-validation-for="Input.Score" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Input.Term" class="form-label">Term</label>
            <select asp-for="Input.Term" class="form-select">
                <option>First Term</option>
                <option>Second Term</option>
                <option>Third Term</option>
            </select>
            <span asp-validation-for="Input.Term" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Input.AcademicYear" class="form-label">Academic year</label>
            <input asp-for="Input.AcademicYear" class="form-control" />
            <span asp-validation-for="Input.AcademicYear" class="text-danger"></span>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">Save Grade</button>
        </div>
    </form>
}

<table class="table table-bordered">
    <thead><tr><th>Student</th><th>Subject</th><th>Term</th><th>Academic year</th><th>Score</th><th>Grade</th><th>Recorded</th></tr></thead>
    <tbody>
        @if (Model.Grades.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted py-4">No grades recorded yet.</td></tr>
        }
        @foreach (var record in Model.Grades)
        {
            <tr>
                <td>@record.Student.FirstName @record.Student.LastName</td>
                <td>@record.Subject</td>
                <td>@record.Term</td>
                <td>@record.AcademicYear</td>
                <td>@record.Score</td>
                <td><strong>@ScholarSync.Models.GradingScale.GetGrade(record.Score, Model.Settings)</strong></td>
                <td>@record.RecordedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const student = document.getElementById('Input_StudentId');
            const subject = document.getElementById('Input_Subject');
            if (!student || !subject) return;
            const filterSubjects = () => {
                const selected = student.options[student.selectedIndex];
                const classId = selected?.dataset.classId;
                [...subject.options].forEach(option => {
                    if (!option.value) return;
                    const ids = (option.dataset.classIds || '').split(',').filter(Boolean);
                    option.hidden = Boolean(classId) && ids.length > 0 && !ids.includes(classId);
                    if (option.hidden && option.selected) subject.value = '';
                });
            };
            student.addEventListener('change', filterSubjects);
            filterSubjects();
        })();
    </script>
}
