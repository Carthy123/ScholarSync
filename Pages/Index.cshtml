@page
@model ScholarSync.Pages.IndexModel

@{
    ViewData["Title"] = "Dashboard";
    ViewData["BodyClass"] = "dashboard-page";
}

<div class="ss-dashboard" style="--school-primary: @Model.Settings.PrimaryColor; --school-accent: @Model.Settings.AccentColor;">
    <aside class="ss-sidebar">
        <div class="ss-brand">Scholar<span>Sync</span></div>
        <div class="ss-menu-heading">MAIN MENU</div>
        <a asp-page="/Index" class="ss-nav-link active"><span>⌂</span> Home</a>
        <a asp-page="/Students/Index" class="ss-nav-link"><span>♙</span> Students</a>
        <a asp-page="/Guardians/Index" class="ss-nav-link"><span>♙</span> Guardians</a>
        <a asp-page="/Classes/Index" class="ss-nav-link"><span>▤</span> Classes</a>
        <a asp-page="/Attendance/Index" class="ss-nav-link"><span>✓</span> Attendance</a>
        <a asp-page="/Notifications/Index" class="ss-nav-link"><span>!</span> Notifications</a>
        <a asp-page="/Calendar/Index" class="ss-nav-link"><span>▣</span> School Calendar</a>
        <a asp-page="/Grades/Index" class="ss-nav-link"><span>★</span> Grades</a>
        <a asp-page="/Fees/Index" class="ss-nav-link"><span>₵</span> Fee Payments</a>
        <a asp-page="/Reports/Index" class="ss-nav-link"><span>▧</span> Reports</a>
        @if (User.IsInRole("Admin"))
        {
            <div class="ss-menu-heading">SYSTEM</div>
            <a asp-page="/Account/Users" class="ss-nav-link"><span>⚙</span> Admin Accounts</a>
            <a asp-page="/Account/Audit" class="ss-nav-link"><span>▣</span> Audit History</a>
            <a asp-page="/Account/Settings" class="ss-nav-link"><span>✦</span> School Settings</a>
            <a asp-page="/Account/Backup" class="ss-nav-link"><span>⬇</span> Backup</a>
        }
        <a asp-page="/Account/ChangePassword" class="ss-nav-link"><span>⌕</span> Change password</a>
        <a asp-page="/Privacy" class="ss-nav-link"><span>⚙</span> Privacy</a>
        <form method="post" asp-page="/Account/Logout" class="ss-sidebar-signout">
            <button type="submit" class="ss-nav-link ss-signout-button"><span>↪</span> Sign out</button>
        </form>
        <div class="ss-sidebar-user">
            <div class="ss-user-avatar">@((User.Identity?.Name ?? "U")[0].ToString().ToUpperInvariant())</div>
            <div class="ss-user-copy"><strong>@User.Identity?.Name</strong><small>@(User.IsInRole("Admin") ? "Administrator" : "Teacher")</small></div>
            <span class="ss-online-dot" title="Signed in"></span>
        </div>
    </aside>

    <main class="ss-main">
        <header class="ss-header">
            <div>
                <div class="ss-eyebrow">SCHOOL ADMINISTRATION</div>
                <h1>Good @(DateTime.Now.Hour < 12 ? "morning" : DateTime.Now.Hour < 17 ? "afternoon" : "evening"), @User.Identity?.Name</h1>
                <p class="ss-muted">@Model.Settings.WelcomeMessage <span class="ss-date">· @DateTime.Today.ToString("dddd, dd MMMM yyyy")</span></p>
            </div>
            <div class="ss-school-badge">
                @if (string.IsNullOrWhiteSpace(Model.Settings.LogoPath))
                {
                    <div class="ss-avatar">SS</div>
                }
                else
                {
                    <img class="ss-avatar" src="@Model.Settings.LogoPath" alt="@Model.Settings.SchoolName crest" style="object-fit:contain;background:#fff;padding:4px;" />
                }
                <div><strong>@Model.Settings.SchoolName</strong><small>Academic year @Model.Settings.AcademicYear</small><small><span class="ss-live-dot"></span>System online</small></div>
            </div>
        </header>

        <section class="ss-command-bar">
            <div>
                <span class="ss-command-kicker">TODAY'S OPERATIONS</span>
                <strong>Keep the school day moving</strong>
                <small>Choose a task to update the records that matter today.</small>
            </div>
            <div class="ss-command-actions">
                <a asp-page="/Students/Create" class="btn ss-command-primary">+ Register student</a>
                <a asp-page="/Attendance/Index" class="btn ss-command-secondary">✓ Take attendance</a>
            </div>
        </section>

        @if (Model.UnassignedStudentCount > 0)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center gap-3">
                <span><strong>Action needed:</strong> @Model.UnassignedStudentCount student(s) still need a class assignment.</span>
                <a asp-page="/Students/Index" class="btn btn-sm btn-warning">Review Students</a>
            </div>
        }

        @if (User.IsInRole("Teacher"))
        {
            <div class="alert alert-info"><strong>Your assigned classes:</strong> @(Model.AssignedClasses.Count == 0 ? "No classes assigned yet." : string.Join(", ", Model.AssignedClasses.Select(schoolClass => $"{schoolClass.Name} ({schoolClass.AcademicYear})")))</div>
        }

        <section class="ss-alert-grid">
            <div class="ss-panel ss-alert-panel">
                <div class="ss-panel-heading"><div><h3>Upcoming activities</h3><p>What is coming up in the school calendar.</p></div><a asp-page="/Calendar/Index" class="btn btn-sm btn-outline-primary">Open calendar</a></div>
                @if (Model.UpcomingEvents.Count == 0)
                {
                    <div class="ss-alert-empty">No upcoming school activities have been added.</div>
                }
                else
                {
                    <div class="ss-upcoming-list">
                    @foreach (var schoolEvent in Model.UpcomingEvents)
                    {
                        <a asp-page="/Calendar/Index" asp-route-year="@schoolEvent.StartDate.Year" asp-route-month="@schoolEvent.StartDate.Month" class="ss-upcoming-item text-decoration-none"><span class="ss-event-date"><strong>@schoolEvent.StartDate.ToString("dd")</strong><small>@schoolEvent.StartDate.ToString("MMM")</small></span><span><strong>@schoolEvent.Title</strong><small>@schoolEvent.EventType · @(schoolEvent.StartDate == schoolEvent.EndDate ? schoolEvent.StartDate.ToString("dddd") : $"{schoolEvent.StartDate:dd MMM} - {schoolEvent.EndDate:dd MMM}")</small></span></a>
                    }
                    </div>
                }
            </div>
            <div class="ss-panel ss-alert-panel">
                <div class="ss-panel-heading"><div><h3>Needs attention</h3><p>Items that may need action today.</p></div><span class="ss-attention-badge">@(Model.UnassignedStudentCount + (Model.AttendanceCompletionPercentage < 100 && Model.StudentCount > 0 ? 1 : 0) + (Model.StudentsWithOutstandingFees > 0 ? 1 : 0) + Model.LockedAccountCount)</span></div>
                <div class="ss-attention-list">
                    @if (Model.UnassignedStudentCount > 0) { <a asp-page="/Students/Index" class="ss-attention-item"><span class="ss-attention-icon warning">!</span><span><strong>@Model.UnassignedStudentCount student(s) need a class</strong><small>Review student assignments</small></span><b>→</b></a> }
                    @if (Model.StudentCount > 0 && Model.AttendanceCompletionPercentage < 100) { <a asp-page="/Attendance/Index" class="ss-attention-item"><span class="ss-attention-icon blue">✓</span><span><strong>Attendance is @Model.AttendanceCompletionPercentage% complete</strong><small>Finish today’s attendance</small></span><b>→</b></a> }
                    @if (Model.StudentsWithOutstandingFees > 0) { <a asp-page="/Fees/Index" class="ss-attention-item"><span class="ss-attention-icon orange">₵</span><span><strong>@Model.StudentsWithOutstandingFees student(s) have balances</strong><small>GHS @Model.OutstandingFees.ToString("N2") outstanding</small></span><b>→</b></a> }
                    @if (User.IsInRole("Admin") && Model.LockedAccountCount > 0) { <a asp-page="/Account/Audit" class="ss-attention-item"><span class="ss-attention-icon red">×</span><span><strong>@Model.LockedAccountCount account(s) locked</strong><small>Review account security</small></span><b>→</b></a> }
                    @if (Model.UnassignedStudentCount == 0 && (Model.StudentCount == 0 || Model.AttendanceCompletionPercentage == 100) && Model.StudentsWithOutstandingFees == 0 && Model.LockedAccountCount == 0) { <div class="ss-alert-empty success">Everything looks up to date.</div> }
                </div>
            </div>
        </section>

        <section class="ss-stats">
            <article class="ss-stat-card"><div class="ss-stat-top"><span>Total Students</span><span class="ss-stat-icon blue">♙</span></div><h2>@Model.StudentCount</h2><p>Currently registered</p></article>
            <article class="ss-stat-card"><div class="ss-stat-top"><span>Total Classes</span><span class="ss-stat-icon green">▤</span></div><h2>@Model.ClassCount</h2><p>Active classes</p></article>
            <article class="ss-stat-card"><div class="ss-stat-top"><span>Unassigned Students</span><span class="ss-stat-icon purple">↗</span></div><h2>@Model.UnassignedStudentCount</h2><p>Need a class assignment</p></article>
            <article class="ss-stat-card"><div class="ss-stat-top"><span>Present Today</span><span class="ss-stat-icon orange">✓</span></div><h2>@Model.TodayPresentCount</h2><p>@Model.TodayAbsentCount absent · @Model.TodayLateCount late</p></article>
            <article class="ss-stat-card"><div class="ss-stat-top"><span>Fees Recorded</span><span class="ss-stat-icon purple">₵</span></div><h2>GHS @Model.TotalFeesReceived.ToString("N0")</h2><p>Total payments entered</p></article>
        </section>

        <section class="ss-analytics-grid">
            <div class="ss-panel ss-analytics-panel">
                <div class="ss-panel-heading"><div><h3>Attendance trend</h3><p>Last seven days across your visible students.</p></div><a asp-page="/Attendance/Index" class="btn btn-sm btn-outline-primary">View records</a></div>
                <div class="ss-trend-list">
                    @foreach (var point in Model.AttendanceTrend)
                    {
                        <div class="ss-trend-row"><span class="ss-trend-label">@point.Date.ToString("ddd")<small>@point.Date.ToString("dd MMM")</small></span><div class="ss-trend-track"><div class="ss-trend-present" style="width: @(Model.StudentCount == 0 ? 0 : point.Present * 100 / Model.StudentCount)%"></div><div class="ss-trend-absent" style="width: @(Model.StudentCount == 0 ? 0 : point.Absent * 100 / Model.StudentCount)%"></div><div class="ss-trend-late" style="width: @(Model.StudentCount == 0 ? 0 : point.Late * 100 / Model.StudentCount)%"></div></div><strong>@point.Marked</strong></div>
                    }
                </div>
                <div class="ss-chart-key"><span><i class="attendance-dot present"></i>Present</span><span><i class="attendance-dot absent"></i>Absent</span><span><i class="attendance-dot late"></i>Late</span></div>
            </div>
            <div class="ss-panel ss-analytics-panel">
                <div class="ss-panel-heading"><div><h3>School performance</h3><p>Current academic year snapshot.</p></div><a asp-page="/Reports/Index" class="btn btn-sm btn-outline-primary">View reports</a></div>
                <div class="ss-performance-item"><div><span>Fee collection</span><strong>GHS @Model.TotalFeesReceived.ToString("N0") <small>of GHS @Model.ExpectedFees.ToString("N0")</small></strong></div><div class="ss-performance-track"><div class="ss-performance-fill fees" style="width: @(Model.ExpectedFees == 0 ? 0 : Math.Min(Model.TotalFeesReceived * 100m / Model.ExpectedFees, 100m))%"></div></div></div>
                <div class="ss-performance-item"><div><span>Average grade score</span><strong>@Model.AverageGradeScore.ToString("N1")% <small>@Model.GradedStudentCount result(s)</small></strong></div><div class="ss-performance-track"><div class="ss-performance-fill grades" style="width: @Math.Min(Model.AverageGradeScore, 100m)%"></div></div></div>
                <div class="ss-performance-item"><div><span>Attendance completion</span><strong>@Model.AttendanceCompletionPercentage% <small>today</small></strong></div><div class="ss-performance-track"><div class="ss-performance-fill attendance" style="width: @Model.AttendanceCompletionPercentage%"></div></div></div>
                <div class="ss-performance-footer"><span>Passing results</span><strong>@Model.PassingGradeCount / @Model.GradedStudentCount</strong></div>
            </div>
        </section>

        <section class="ss-content-grid">
            <div class="ss-panel">
                <div class="ss-panel-heading"><div><h3>Recent students</h3><p>The latest registered student records.</p></div><span class="ss-status">Live</span></div>
                @if (Model.RecentStudents.Count == 0)
                {
                    <div class="ss-empty-state"><div class="ss-empty-icon">✓</div><h4>No students yet</h4><p>Register a student to see activity here.</p></div>
                }
                else
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Student</th><th>Class</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var student in Model.RecentStudents)
                                {
                                    <tr>
                                        <td>@student.FirstName @student.LastName</td>
                                        <td>@(student.SchoolClass?.Name ?? "Unassigned")</td>
                                        <td><span class="badge text-bg-success">Registered</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="ss-panel">
                <div class="ss-panel-heading"><div><h3>Quick actions</h3><p>Common tasks at your fingertips.</p></div></div>
                <div class="ss-quick-actions">
                    <a asp-page="/Students/Create" class="ss-action text-decoration-none"><span class="ss-action-icon blue">+</span><div><strong>Register Student</strong><p>Add a new student record</p></div></a>
                    <a asp-page="/Classes/Create" class="ss-action text-decoration-none"><span class="ss-action-icon purple">▤</span><div><strong>Manage Classes</strong><p>Organize classes and academic years</p></div></a>
                    <a asp-page="/Attendance/Index" class="ss-action text-decoration-none"><span class="ss-action-icon green">✓</span><div><strong>Take Attendance</strong><p>Record today’s attendance</p></div></a>
                    <a asp-page="/Grades/Index" class="ss-action text-decoration-none"><span class="ss-action-icon orange">★</span><div><strong>Record Grades</strong><p>Add academic results</p></div></a>
                    <a asp-page="/Fees/Index" class="ss-action text-decoration-none"><span class="ss-action-icon purple">₵</span><div><strong>Record Fees</strong><p>Track school payments</p></div></a>
                </div>
            </div>
        </section>

        <section class="ss-panel mt-4">
            <div class="ss-panel-heading"><div><h3>Recent grades</h3><p>The latest academic results entered.</p></div><a asp-page="/Grades/Index" class="btn btn-sm btn-outline-primary">View all</a></div>
            @if (Model.RecentGrades.Count == 0)
            {
                <div class="ss-empty-state"><div class="ss-empty-icon">★</div><h4>No grades recorded yet</h4><p>Use Record Grades to add academic results.</p></div>
            }
            else
            {
                <div class="table-responsive mt-3"><table class="table table-sm align-middle mb-0"><thead><tr><th>Student</th><th>Subject</th><th>Score</th><th>Grade</th></tr></thead><tbody>
                    @foreach (var record in Model.RecentGrades)
                    {
                        <tr><td>@record.Student.FirstName @record.Student.LastName</td><td>@record.Subject</td><td>@record.Score</td><td><strong>@record.Grade</strong></td></tr>
                    }
                </tbody></table></div>
            }
        </section>

        <section class="ss-content-grid mt-4">
            <div class="ss-panel">
                <div class="ss-panel-heading"><div><h3>Class enrollment</h3><p>Student distribution across classes.</p></div><a asp-page="/Classes/Index" class="btn btn-sm btn-outline-primary">Manage</a></div>
                @if (Model.ClassSummaries.Count == 0)
                {
                    <div class="ss-empty-state"><div class="ss-empty-icon">▤</div><h4>No classes yet</h4><p>Create classes to see enrollment information.</p></div>
                }
                else
                {
                    <div class="table-responsive mt-3"><table class="table table-sm align-middle mb-0"><thead><tr><th>Class</th><th>Year</th><th>Students</th></tr></thead><tbody>
                        @foreach (var schoolClass in Model.ClassSummaries)
                        {
                            <tr><td><strong>@schoolClass.Name</strong></td><td>@schoolClass.AcademicYear</td><td><span class="badge text-bg-primary">@schoolClass.Students.Count</span></td></tr>
                        }
                    </tbody></table></div>
                    <div class="enrollment-bars mt-4">
                        @foreach (var schoolClass in Model.ClassSummaries)
                        {
                            var maxEnrollment = Math.Max(Model.ClassSummaries.Max(item => item.Students.Count), 1);
                            <div class="enrollment-bar-row"><div class="d-flex justify-content-between small"><span>@schoolClass.Name</span><strong>@schoolClass.Students.Count</strong></div><div class="enrollment-bar-track"><div class="enrollment-bar-fill" style="width: @(schoolClass.Students.Count * 100 / maxEnrollment)%"></div></div></div>
                        }
                    </div>
                }
            </div>
            <div class="ss-panel">
                <div class="ss-panel-heading"><div><h3>Attendance overview</h3><p>Today’s attendance status.</p></div><a asp-page="/Attendance/Index" class="btn btn-sm btn-outline-primary">Update</a></div>
                @{ var marked = Model.TodayPresentCount + Model.TodayAbsentCount + Model.TodayLateCount; var unmarked = Math.Max(Model.StudentCount - marked, 0); }
                <div class="attendance-overview mt-4">
                    <div class="attendance-row"><span><i class="attendance-dot present"></i>Present</span><strong>@Model.TodayPresentCount</strong></div>
                    <div class="attendance-row"><span><i class="attendance-dot absent"></i>Absent</span><strong>@Model.TodayAbsentCount</strong></div>
                    <div class="attendance-row"><span><i class="attendance-dot late"></i>Late</span><strong>@Model.TodayLateCount</strong></div>
                    <div class="attendance-row"><span><i class="attendance-dot unmarked"></i>Not marked</span><strong>@unmarked</strong></div>
                </div>
                <div class="progress mt-3" role="progressbar" aria-label="Attendance marked today" aria-valuenow="@marked" aria-valuemin="0" aria-valuemax="@Model.StudentCount">
                    <div class="progress-bar bg-success" style="width: @(Model.StudentCount == 0 ? 0 : marked * 100 / Model.StudentCount)%"></div>
                </div>
                <small class="text-muted">@marked of @Model.StudentCount student(s) marked today · @Model.AttendanceCompletionPercentage% complete</small>
            </div>
        </section>

        <footer class="ss-footer"><span>ScholarSync school management system</span><span>© 2026 ScholarSync</span></footer>
    </main>
</div>
