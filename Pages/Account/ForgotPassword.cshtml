@page
@model ScholarSync.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center mt-5"><div class="col-md-5 col-lg-4"><div class="card shadow-sm"><div class="card-body p-4">
    <h1 class="h3 mb-2">Forgot password?</h1>
    @if (Model.Submitted)
    {
        <div class="alert alert-info">If an account exists for that email, a password reset link has been sent.</div>
        <a asp-page="/Account/Login" class="btn btn-primary w-100">Return to login</a>
    }
    else
    {
        <p class="text-muted">Enter your administrator email and we’ll send a secure reset link.</p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="Email" class="form-label">Email address</label><input asp-for="Email" type="email" class="form-control" autocomplete="email" /></div>
            <button type="submit" class="btn btn-primary w-100">Send reset link</button>
        </form>
    }
</div></div></div></div>
