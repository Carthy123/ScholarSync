@page
@model ScholarSync.Pages.Account.UsersModel

@{
    ViewData["Title"] = "Admin Accounts";
}

<h1>Admin Accounts</h1>
<p class="text-muted">Create and manage administrator access.</p>

@if (TempData["AccountError"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5>Add administrator</h5>
        <form method="post" asp-page-handler="Create" class="row g-3">
            <div class="col-md-4"><label asp-for="Input.Username" class="form-label">Username</label><input asp-for="Input.Username" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="Input.Password" class="form-label">Temporary password</label><input asp-for="Input.Password" type="password" class="form-control" /></div>
            <div class="col-md-4 d-flex align-items-end"><button type="submit" class="btn btn-primary">Add administrator</button></div>
            <div class="col-12"><div asp-validation-summary="ModelOnly" class="text-danger"></div></div>
        </form>
    </div>
</div>

<table class="table table-bordered">
    <thead><tr><th>Username</th><th>Created</th><th>Action</th></tr></thead>
    <tbody>
        @foreach (var admin in Model.Admins)
        {
            <tr>
                <td>@admin.Username</td>
                <td>@admin.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                <td><form method="post" asp-page-handler="Delete" asp-route-id="@admin.Id" onsubmit="return confirm('Delete this administrator?');"><button type="submit" class="btn btn-sm btn-outline-danger">Delete</button></form></td>
            </tr>
        }
    </tbody>
</table>
