@page
@model ScholarSync.Pages.Account.SettingsModel

@{
    ViewData["Title"] = "School Settings";
}

<h1>School Branding & Settings</h1>
<p class="text-muted">Customize the school identity shown across the dashboard.</p>

@if (TempData["SettingsSaved"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-md-6"><label asp-for="Settings.SchoolName" class="form-label">School name</label><input asp-for="Settings.SchoolName" class="form-control" /><span asp-validation-for="Settings.SchoolName" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Settings.AcademicYear" class="form-label">Academic year</label><input asp-for="Settings.AcademicYear" class="form-control" /><span asp-validation-for="Settings.AcademicYear" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="Settings.WelcomeMessage" class="form-label">Dashboard welcome message</label><input asp-for="Settings.WelcomeMessage" class="form-control" /><span asp-validation-for="Settings.WelcomeMessage" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Settings.SchoolAddress" class="form-label">School address</label><input asp-for="Settings.SchoolAddress" class="form-control" placeholder="Street, town, region" /><span asp-validation-for="Settings.SchoolAddress" class="text-danger"></span></div>
            <div class="col-md-3"><label asp-for="Settings.SchoolPhone" class="form-label">School phone</label><input asp-for="Settings.SchoolPhone" class="form-control" placeholder="024 000 0000" /><span asp-validation-for="Settings.SchoolPhone" class="text-danger"></span></div>
            <div class="col-md-3"><label asp-for="Settings.SchoolEmail" class="form-label">School email</label><input asp-for="Settings.SchoolEmail" class="form-control" placeholder="office@school.edu.gh" /><span asp-validation-for="Settings.SchoolEmail" class="text-danger"></span></div>
            <div class="col-md-6">
                <label asp-for="Settings.PrimaryColor" class="form-label">Primary color</label>
                <div class="d-flex align-items-center gap-2">
                    <input asp-for="Settings.PrimaryColor" type="color" class="form-control form-control-color" title="Choose the primary school color" />
                    <span class="text-muted small">Used for the dashboard navigation.</span>
                </div>
                <span asp-validation-for="Settings.PrimaryColor" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Settings.AccentColor" class="form-label">Accent color</label>
                <div class="d-flex align-items-center gap-2">
                    <input asp-for="Settings.AccentColor" type="color" class="form-control form-control-color" title="Choose the accent school color" />
                    <span class="text-muted small">Used for highlights and dashboard accents.</span>
                </div>
                <span asp-validation-for="Settings.AccentColor" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="CrestFile" class="form-label">School crest or logo</label>
                <input asp-for="CrestFile" type="file" accept=".png,.jpg,.jpeg,.webp" class="form-control" />
                <div class="form-text">Use a PNG, JPG, JPEG, or WEBP image up to 2 MB.</div>
                <span asp-validation-for="CrestFile" class="text-danger"></span>
                @if (!string.IsNullOrWhiteSpace(Model.Settings.LogoPath))
                {
                    <div class="mt-3 d-flex align-items-center gap-3"><img src="@Model.Settings.LogoPath" alt="Current school crest" style="width:72px;height:72px;object-fit:contain" /><span class="text-muted">Current crest</span></div>
                }
            </div>
            <div class="col-12 mt-4">
                <h2 class="h5 mb-1">Dashboard sections</h2>
                <p class="text-muted small">Choose which optional sections appear on the dashboard. Changes apply to administrators and teachers.</p>
                <div class="row g-2">
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowAnnouncements" class="form-check-input" /><label asp-for="Settings.ShowAnnouncements" class="form-check-label">School bulletin</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowUpcomingActivities" class="form-check-input" /><label asp-for="Settings.ShowUpcomingActivities" class="form-check-label">Upcoming activities</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowNeedsAttention" class="form-check-input" /><label asp-for="Settings.ShowNeedsAttention" class="form-check-label">Needs attention</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowTeacherWorkload" class="form-check-input" /><label asp-for="Settings.ShowTeacherWorkload" class="form-check-label">Teacher workload</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowAnalytics" class="form-check-input" /><label asp-for="Settings.ShowAnalytics" class="form-check-label">Analytics and performance</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowRecentStudents" class="form-check-input" /><label asp-for="Settings.ShowRecentStudents" class="form-check-label">Recent students</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowQuickActions" class="form-check-input" /><label asp-for="Settings.ShowQuickActions" class="form-check-label">Quick actions</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowRecentGrades" class="form-check-input" /><label asp-for="Settings.ShowRecentGrades" class="form-check-label">Recent grades</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowClassEnrollment" class="form-check-input" /><label asp-for="Settings.ShowClassEnrollment" class="form-check-label">Class enrollment</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowAttendanceOverview" class="form-check-input" /><label asp-for="Settings.ShowAttendanceOverview" class="form-check-label">Attendance overview</label></div></div>
                </div>
                <h3 class="h6 mt-4 mb-1">Quick actions</h3>
                <p class="text-muted small">Keep the most useful shortcuts on the dashboard.</p>
                <div class="row g-2">
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowStudentQuickAction" class="form-check-input" /><label asp-for="Settings.ShowStudentQuickAction" class="form-check-label">Register student</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowClassQuickAction" class="form-check-input" /><label asp-for="Settings.ShowClassQuickAction" class="form-check-label">Manage classes</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowAttendanceQuickAction" class="form-check-input" /><label asp-for="Settings.ShowAttendanceQuickAction" class="form-check-label">Take attendance</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowGradesQuickAction" class="form-check-input" /><label asp-for="Settings.ShowGradesQuickAction" class="form-check-label">Record grades</label></div></div>
                    <div class="col-md-4"><div class="form-check"><input asp-for="Settings.ShowFeesQuickAction" class="form-check-input" /><label asp-for="Settings.ShowFeesQuickAction" class="form-check-label">Record fees</label></div></div>
                </div>
            </div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Save settings</button><a asp-page="/Index" class="btn btn-secondary ms-2">Back to dashboard</a></div>
        </form>
    </div>
</div>
