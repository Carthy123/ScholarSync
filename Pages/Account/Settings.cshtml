@page
@model ScholarSync.Pages.Account.SettingsModel

@{
    ViewData["Title"] = "School Settings";
}

<h1>School Branding & Settings</h1>
<p class="text-muted">Customize the school identity shown across the dashboard.</p>

@if (TempData["SettingsSaved"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-md-6"><label asp-for="Settings.SchoolName" class="form-label">School name</label><input asp-for="Settings.SchoolName" class="form-control" /><span asp-validation-for="Settings.SchoolName" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Settings.AcademicYear" class="form-label">Academic year</label><input asp-for="Settings.AcademicYear" class="form-control" /><span asp-validation-for="Settings.AcademicYear" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="Settings.WelcomeMessage" class="form-label">Dashboard welcome message</label><input asp-for="Settings.WelcomeMessage" class="form-control" /><span asp-validation-for="Settings.WelcomeMessage" class="text-danger"></span></div>
            <div class="col-md-6">
                <label asp-for="Settings.PrimaryColor" class="form-label">Primary color</label>
                <div class="d-flex align-items-center gap-2">
                    <input asp-for="Settings.PrimaryColor" type="color" class="form-control form-control-color" title="Choose the primary school color" />
                    <span class="text-muted small">Used for the dashboard navigation.</span>
                </div>
                <span asp-validation-for="Settings.PrimaryColor" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Settings.AccentColor" class="form-label">Accent color</label>
                <div class="d-flex align-items-center gap-2">
                    <input asp-for="Settings.AccentColor" type="color" class="form-control form-control-color" title="Choose the accent school color" />
                    <span class="text-muted small">Used for highlights and dashboard accents.</span>
                </div>
                <span asp-validation-for="Settings.AccentColor" class="text-danger"></span>
            </div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Save settings</button><a asp-page="/Index" class="btn btn-secondary ms-2">Back to dashboard</a></div>
        </form>
    </div>
</div>
