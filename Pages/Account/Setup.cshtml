@page
@model ScholarSync.Pages.Account.SetupModel

@{
    ViewData["Title"] = "Create Admin Account";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-2">Create admin account</h1>
                <p class="text-muted">This one-time setup creates the first administrator.</p>
                @if (Model.HasExistingAccount)
                {
                    <div class="alert alert-info">An administrator account already exists for this ScholarSync installation.</div>
                    <a asp-page="/Account/Login" class="btn btn-primary w-100">Log in with existing account</a>
                }
                else
                {
                    <form method="post">
                        <div class="mb-3"><label asp-for="Input.Username" class="form-label">Username</label><input asp-for="Input.Username" class="form-control" autocomplete="username" /><span asp-validation-for="Input.Username" class="text-danger"></span></div>
                        <div class="mb-3"><label asp-for="Input.Password" class="form-label">Password</label><input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Input.Password" class="text-danger"></span></div>
                        <div class="mb-3"><label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label><input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div>
                        <button type="submit" class="btn btn-primary w-100">Create account</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
