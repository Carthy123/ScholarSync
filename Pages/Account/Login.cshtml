@page
@model ScholarSync.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Admin Login";
    ViewData["BodyClass"] = "login-page";
}

<div class="login-shell" style="--school-primary: @Model.Settings.PrimaryColor; --school-accent: @Model.Settings.AccentColor;">
    <div class="login-layout">
        <div class="login-welcome">
            <div class="login-school-mark">
                @if (!string.IsNullOrWhiteSpace(Model.Settings.LogoPath))
                {
                    <img src="@Model.Settings.LogoPath" alt="@Model.Settings.SchoolName crest" />
                }
                else
                {
                    <span>SS</span>
                }
            </div>
            <div class="login-eyebrow">STAFF PORTAL · @Model.Settings.AcademicYear</div>
            <h1>@Model.Settings.SchoolName</h1>
            <p class="login-welcome-message">@Model.Settings.WelcomeMessage</p>
            <div class="login-identity-panel">
                <div class="login-identity-title">School administration</div>
                <div class="login-identity-row"><span class="identity-icon">⌂</span><div><strong>One connected school record</strong><small>Students · Classes · Attendance · Results · Fees</small></div></div>
                @if (!string.IsNullOrWhiteSpace(Model.Settings.SchoolAddress) || !string.IsNullOrWhiteSpace(Model.Settings.SchoolPhone))
                {
                    <div class="login-contact">@Model.Settings.SchoolAddress@(string.IsNullOrWhiteSpace(Model.Settings.SchoolAddress) || string.IsNullOrWhiteSpace(Model.Settings.SchoolPhone) ? "" : " · ")@Model.Settings.SchoolPhone</div>
                }
            </div>
        </div>

        <div class="login-card">
            <div class="login-card-brand"><div class="login-card-icon">→</div><span>SECURE SIGN-IN</span></div>
            <div class="login-card-school">@Model.Settings.SchoolName · Staff access</div>
            <h2>Sign in</h2>
            <p class="text-muted">Access your school workspace securely.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Input.Username" class="form-label">Username</label>
                    <input asp-for="Input.Username" class="form-control form-control-lg" autocomplete="username" placeholder="Enter your username" />
                </div>
                <div class="mb-4">
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <input asp-for="Input.Password" type="password" class="form-control form-control-lg" autocomplete="current-password" placeholder="Enter your password" />
                </div>
                <button type="submit" class="btn login-submit btn-lg w-100">Sign in securely</button>
            </form>
            <div class="text-center mt-3"><a asp-page="/Account/ForgotPassword">Forgot password?</a></div>
            <div class="login-card-footer">Protected school records · ScholarSync</div>
        </div>
    </div>
</div>
