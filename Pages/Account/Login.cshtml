@page
@model ScholarSync.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Admin Login";
    ViewData["BodyClass"] = "login-page";
}

<div class="login-shell login-portal" style="--school-primary: @Model.Settings.PrimaryColor; --school-accent: @Model.Settings.AccentColor;">
    <div class="login-portal-frame">
        <section class="login-school-panel">
            <div class="login-school-panel-top"><span>STAFF PORTAL</span><span>ACADEMIC YEAR @Model.Settings.AcademicYear</span></div>
            <div class="login-school-identity">
                <div class="login-school-mark">
                    @if (!string.IsNullOrWhiteSpace(Model.Settings.LogoPath)) { <img src="@Model.Settings.LogoPath" alt="@Model.Settings.SchoolName crest" /> } else { <span>SS</span> }
                </div>
                <div class="login-school-rule"></div>
                <h1>@Model.Settings.SchoolName</h1>
                <p>@Model.Settings.WelcomeMessage</p>
            </div>
            <div class="login-school-details">
                <div><span>School administration</span><strong>One connected record for every learner</strong></div>
                @if (!string.IsNullOrWhiteSpace(Model.Settings.SchoolAddress)){<small>@Model.Settings.SchoolAddress</small>}
                @if (!string.IsNullOrWhiteSpace(Model.Settings.SchoolPhone) || !string.IsNullOrWhiteSpace(Model.Settings.SchoolEmail)){<small>@Model.Settings.SchoolPhone@(string.IsNullOrWhiteSpace(Model.Settings.SchoolPhone) || string.IsNullOrWhiteSpace(Model.Settings.SchoolEmail) ? "" : " · ")@Model.Settings.SchoolEmail</small>}
            </div>
        </section>
        <section class="login-form-panel">
            <div class="login-form-heading"><span class="login-form-overline">AUTHORIZED STAFF ONLY</span><h2>Welcome back</h2><p>Sign in to manage today’s school activities.</p></div>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="login-field mb-3"><label asp-for="Input.Username" class="form-label">Username</label><input asp-for="Input.Username" class="form-control form-control-lg" autocomplete="username" placeholder="Your staff username" /></div>
                <div class="login-field mb-3"><label asp-for="Input.Password" class="form-label">Password</label><input asp-for="Input.Password" type="password" class="form-control form-control-lg" autocomplete="current-password" placeholder="Your password" /></div>
                <div class="d-flex justify-content-between align-items-center mb-4"><span class="login-secure-note"><i></i>Protected school access</span><a asp-page="/Account/ForgotPassword">Forgot password?</a></div>
                <button type="submit" class="btn login-submit btn-lg w-100">Enter school workspace <span>→</span></button>
            </form>
            <div class="login-form-footer"><span>Need access?</span> Contact your school administrator.<br /><small>ScholarSync keeps student records organized and protected.</small></div>
        </section>
    </div>
</div>
