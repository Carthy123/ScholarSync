@page
@model ScholarSync.Pages.Account.ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center mt-5"><div class="col-md-5 col-lg-4"><div class="card shadow-sm"><div class="card-body p-4">
    <h1 class="h3 mb-2">Reset password</h1>
    @if (!Model.IsValidToken)
    {
        <div class="alert alert-danger">This reset link is invalid or has expired.</div>
        <a asp-page="/Account/ForgotPassword" class="btn btn-primary w-100">Request a new link</a>
    }
    else
    {
        <p class="text-muted">Choose a new password with at least 8 characters.</p>
        <form method="post">
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="Password" class="form-label">New password</label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" /></div>
            <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" /></div>
            <button type="submit" class="btn btn-primary w-100">Reset password</button>
        </form>
    }
</div></div></div></div>
