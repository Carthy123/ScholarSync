@page
@model ScholarSync.Pages.Account.AuditModel
@{
    ViewData["Title"] = "Audit History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Audit History</h1>
        <p class="text-muted mb-0">Review recent sign-ins and important changes made in ScholarSync.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Account/Audit">Refresh</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label for="search" class="form-label">Search activity</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Username, action, area, or details" />
            </div>
            <div class="col-md-4">
                <label for="action" class="form-label">Filter by action</label>
                <select id="action" name="action" class="form-select">
                    <option value="">All actions</option>
                    @foreach (var action in Model.Actions)
                    {
                        <option value="@action" selected="@(Model.SelectedAction == action ? "selected" : null)">@action</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-page="/Account/Audit" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1">Locked accounts</h5>
                <p class="text-muted mb-0">Accounts temporarily locked after repeated failed sign-in attempts.</p>
            </div>
            <span class="badge @(Model.LockedUsers.Count == 0 ? "text-bg-success" : "text-bg-warning")">@Model.LockedUsers.Count active</span>
        </div>
        @if (Model.LockedUsers.Count == 0)
        {
            <p class="text-muted mt-3 mb-0">No accounts are currently locked.</p>
        }
        else
        {
            <div class="table-responsive mt-3">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Username</th><th>Unlocks at</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var user in Model.LockedUsers)
                    {
                        <tr>
                            <td>@user.Username</td>
                            <td>@user.LockoutEnd?.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</td>
                            <td class="text-end"><form method="post" asp-page-handler="Unlock" asp-route-id="@user.Id"><button type="submit" class="btn btn-sm btn-outline-primary">Unlock now</button></form></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date and time</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Area</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Logs.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No audit activity has been recorded yet.</td></tr>
            }
            else
            {
                foreach (var log in Model.Logs)
                {
                    <tr>
                        <td>@log.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</td>
                        <td>@log.Username</td>
                        <td><span class="badge bg-primary">@log.Action</span></td>
                        <td>@log.EntityType@(log.EntityId.HasValue ? $" #{log.EntityId}" : string.Empty)</td>
                        <td>@(string.IsNullOrWhiteSpace(log.Details) ? "—" : log.Details)</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
