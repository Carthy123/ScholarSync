@page
@model ScholarSync.Pages.Account.SetupWizardModel
@{ ViewData["Title"] = "School Setup Wizard"; }

<div class="setup-wizard-header"><div><span class="text-uppercase text-primary small fw-bold">Administrator onboarding</span><h1 class="mb-1">School Setup Wizard</h1><p class="text-muted mb-0">Prepare ScholarSync for your school in one guided workspace.</p></div><a asp-page="/Index" class="btn btn-outline-secondary">Back to dashboard</a></div>
@if (TempData["WizardSaved"] is string message){<div class="alert alert-success">@message</div>}

<div class="setup-progress mb-4"><div class="setup-progress-step active"><span>1</span><strong>School identity</strong><small>Name, year, contact</small></div><div class="setup-progress-line"></div><div class="setup-progress-step active"><span>2</span><strong>Branding</strong><small>Crest and colors</small></div><div class="setup-progress-line"></div><div class="setup-progress-step active"><span>3</span><strong>Readiness</strong><small>Check your workspace</small></div></div>

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="card shadow-sm mb-4 setup-section"><div class="card-body"><div class="setup-section-heading"><span>01</span><div><h2>School identity</h2><p>These details appear on the login page, dashboard, reports, and receipts.</p></div></div><div class="row g-3"><div class="col-md-6"><label asp-for="Settings.SchoolName" class="form-label">School name</label><input asp-for="Settings.SchoolName" class="form-control" /><span asp-validation-for="Settings.SchoolName" class="text-danger"></span></div><div class="col-md-3"><label asp-for="Settings.AcademicYear" class="form-label">Academic year</label><input asp-for="Settings.AcademicYear" class="form-control" /><span asp-validation-for="Settings.AcademicYear" class="text-danger"></span></div><div class="col-md-3"><label asp-for="Settings.SchoolPhone" class="form-label">School phone</label><input asp-for="Settings.SchoolPhone" class="form-control" /></div><div class="col-md-6"><label asp-for="Settings.SchoolAddress" class="form-label">Address</label><input asp-for="Settings.SchoolAddress" class="form-control" placeholder="Town, region" /></div><div class="col-md-6"><label asp-for="Settings.SchoolEmail" class="form-label">School email</label><input asp-for="Settings.SchoolEmail" class="form-control" /></div><div class="col-12"><label asp-for="Settings.WelcomeMessage" class="form-label">Welcome message</label><input asp-for="Settings.WelcomeMessage" class="form-control" /><span asp-validation-for="Settings.WelcomeMessage" class="text-danger"></span></div></div></div></div>
    <div class="card shadow-sm mb-4 setup-section"><div class="card-body"><div class="setup-section-heading"><span>02</span><div><h2>School branding</h2><p>Use the school’s actual colors and crest so the platform feels like your school.</p></div></div><div class="row g-3"><div class="col-md-6"><label asp-for="Settings.PrimaryColor" class="form-label">Primary school color</label><input asp-for="Settings.PrimaryColor" type="color" class="form-control form-control-color" /><span asp-validation-for="Settings.PrimaryColor" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Settings.AccentColor" class="form-label">Accent school color</label><input asp-for="Settings.AccentColor" type="color" class="form-control form-control-color" /><span asp-validation-for="Settings.AccentColor" class="text-danger"></span></div><div class="col-12"><label asp-for="CrestFile" class="form-label">School crest or logo</label><input asp-for="CrestFile" type="file" accept=".png,.jpg,.jpeg,.webp" class="form-control" /><div class="form-text">PNG, JPG, JPEG, or WEBP up to 2 MB.</div><span asp-validation-for="CrestFile" class="text-danger"></span></div></div></div></div>
    <div class="card shadow-sm mb-4 setup-section"><div class="card-body"><div class="setup-section-heading"><span>03</span><div><h2>Workspace readiness</h2><p>Review these areas before introducing the platform to staff.</p></div></div><div class="setup-readiness"><div><span class="setup-check @(Model.HasCrest ? "done" : "pending")">@(Model.HasCrest ? "✓" : "!")</span><strong>School crest</strong><small>@(Model.HasCrest ? "Uploaded and ready" : "Upload a crest above")</small></div><div><span class="setup-check @(Model.AccountCount > 0 ? "done" : "pending")">@(Model.AccountCount > 0 ? "✓" : "!")</span><strong>Administrator account</strong><small>@Model.AccountCount account(s) available</small></div><div><span class="setup-check @(Model.ClassCount > 0 ? "done" : "pending")">@(Model.ClassCount > 0 ? "✓" : "!")</span><strong>School classes</strong><small>@Model.ClassCount class(es) available</small></div></div><div class="mt-3 d-flex flex-wrap gap-2"><a asp-page="/Account/Users" class="btn btn-sm btn-outline-primary">Manage accounts</a><a asp-page="/Classes/Index" class="btn btn-sm btn-outline-primary">Review classes</a><a asp-page="/Account/Backup" class="btn btn-sm btn-outline-primary">Create first backup</a></div></div></div>
    <div class="d-flex justify-content-end gap-2"><a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-primary">Save school setup</button></div>
</form>
